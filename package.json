{
  "name": "couch-movers",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names SERVER,CLIENT --prefix-colors yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace @couch-movers/client",
    "dev:server": "npm run dev --workspace @couch-movers/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "smoke:changed": "node scripts/changed-features-smoke.mjs",
    "smoke:network": "node scripts/network-cadence-smoke.mjs",
    "smoke:spawns": "node scripts/spawn-safety-smoke.mjs",
    "smoke:ladder": "node scripts/ladder-runtime-smoke.mjs",
    "audit:levels": "node scripts/level-audit.mjs",
    "audit:ladder": "node scripts/rope-physics-audit.mjs",
    "audit:rope": "node scripts/rope-physics-audit.mjs",
    "deploy:check": "npm run build --workspace @couch-movers/client && wrangler deploy --config wrangler.deploy.jsonc --dry-run --outdir dist/deploy",
    "deploy": "npm run build --workspace @couch-movers/client && wrangler deploy --config wrangler.deploy.jsonc"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
